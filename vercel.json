{
    "version": 2,
    "name": "taiwan-flight-load-factor",
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "outputDirectory": ".",
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/link",
            "destination": "/link/index.html"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600, must-revalidate"
                }
            ]
        },
        {
            "source": "/data/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=86400"
                }
            ]
        }
    ]
}